# Copy to .env and fill in what you use. Values here override the Settings page
# and are never written to the database. .env is git-ignored.

# GitHub personal access token (scopes: repo, project)
MAESTRO_GITHUB_TOKEN=

# Claude Code auth, only needed for the matching auth mode in Settings
# Long-lived token from `claude setup-token` (mode: oauth_token)
MAESTRO_CLAUDE_OAUTH_TOKEN=
# Anthropic API key (mode: api_key)
MAESTRO_ANTHROPIC_API_KEY=

# Server
# MAESTRO_ADDR=127.0.0.1:7878
# MAESTRO_DATA=./maestro-data
# RUST_LOG=maestro=info
